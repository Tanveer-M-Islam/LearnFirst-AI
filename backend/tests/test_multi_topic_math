    )


@pytest.mark.parametrize(
    "concept_code",
    MATH_CONCEPTS,
)
def test_every_adaptive_problem_is_supported(
    concept_code: str,
):

    for difficulty in (
        DifficultyLevel.EASY,

        DifficultyLevel.MODERATE,

        DifficultyLevel.CHALLENGING,
    ):

        for offset in range(
            3
        ):

            problem = (
                get_adaptive_problem(
                    concept_code=(
                        concept_code
                    ),

                    difficulty=(
                        difficulty
                    ),

                    offset=(
                        offset
                    ),
                )
            )


            assert (
                problem
                is not None
            )


            result = (
                MathValidator
                .validate(
                    problem=(
                        problem.prompt
                    ),

                    student_message=(
                        "0"
                    ),
                )
            )


            assert (
                result.supported
                is True
            )


