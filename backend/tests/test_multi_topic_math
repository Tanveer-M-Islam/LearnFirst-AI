import pytest

from app.adaptive.problem_bank import (
    PROBLEM_BANK,
    get_adaptive_problem,
)
from app.assessment.question_bank import (
    get_assessment_questions,
)
from app.math.validator import (
    MathValidator,
)
from app.schemas.enums import (
    AssessmentType,
    DifficultyLevel,
)


MATH_CONCEPTS = [

    "MATH_ARITH_BASIC_01",

    "MATH_ARITH_MULTDIV_01",

    "MATH_ARITH_FRAC_01",

    "MATH_ARITH_INT_01",

    "MATH_ARITH_ORDER_01",

    "MATH_PREALG_EXPR_01",

    "MATH_ALG_LINEAR_01",

    "MATH_GRAPH_LINEAR_01",
]


@pytest.mark.parametrize(
    "concept_code",
    MATH_CONCEPTS,
)
def test_every_math_topic_has_adaptive_bank(
    concept_code: str,
):

    assert (
        concept_code
        in PROBLEM_BANK
    )


    for difficulty in (
        DifficultyLevel.EASY,

        DifficultyLevel.MODERATE,

        DifficultyLevel.CHALLENGING,
    ):

        problems = (
            PROBLEM_BANK[
                concept_code
            ][
                difficulty
            ]
        )


        assert (
            len(
                problems
            )
            >= 3
        )


@pytest.mark.parametrize(
    "concept_code",
    MATH_CONCEPTS,
)
@pytest.mark.parametrize(
    "assessment_type",
    (
        AssessmentType.DIAGNOSTIC,

