def test_pre_algebra_substitution_correct():

    result = (
        MathValidator
        .validate(
            problem=(
                "3x + 2 when x = 4"
            ),

            student_message=(
                "14"
            ),
        )
    )


    assert (
        result.supported
        is True
    )


    assert (
        result.is_correct
        is True
    )


    assert (
        result.problem_type.value
        == "SUBSTITUTION"
    )


