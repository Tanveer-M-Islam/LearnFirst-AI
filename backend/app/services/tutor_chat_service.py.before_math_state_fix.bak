
"""LearnFirst AI tutor chat orchestration.

Includes:
- Math, Science and English tutoring
- Deterministic attempt validation
- Adaptive practice and curriculum RAG
- AI-02 direct-answer protection
- AI-04 Math step recognition
- AI-05 incorrect-answer feedback and output guard
"""

import re
from decimal import Decimal, InvalidOperation

from sqlalchemy.orm import Session

from app.adaptive.problem_bank import get_adaptive_problem
from app.database.repositories.session_repository import LearningSessionRepository
from app.database.repositories.student_attempt_repository import StudentAttemptRepository
from app.database.repositories.student_repository import StudentRepository
from app.services.chat_history_service import ChatHistoryService
from app.math.parser import evaluate_arithmetic

from app.english.attempt_service import EnglishAttemptService
from app.english.evaluator import EnglishEvaluator
from app.english.models import (
    EnglishValidationResult,
    create_public_english_validation,
)
from app.english.question_bank import get_english_question
from app.intent.router import IntentRouter
from app.llm.gateway import LLMGateway
from app.math.attempt_service import MathAttemptService
from app.math.models import (
    MathValidationResult,
    create_public_validation,
)
from app.rag.models import RAGContext
from app.rag.query_builder import RAGQueryBuilder
from app.rag.service import RAGService
from app.science.attempt_service import ScienceAttemptService
from app.science.evaluator import ScienceUnderstandingEvaluator
from app.science.models import (
    ScienceValidationResult,
    create_public_science_validation,
)
from app.science.question_bank import get_science_question
from app.schemas.chat import TutorMessageResponse
from app.schemas.enums import (
    AgeGroup,
    AttemptStatus,
    DifficultyLevel,
    LearningMode,
    MasteryState,
    Subject,
    TutorAction,
    TutorIntent,
)
from app.services.adaptive_learning_service import AdaptiveLearningService
from app.services.english_adaptive_learning_service import EnglishAdaptiveLearningService
from app.services.science_adaptive_learning_service import ScienceAdaptiveLearningService
from app.services.tutor_service import TutorService
from app.tutor.decision_models import TutorDecisionInput
from app.tutor.prompt_builder import TutorPromptBuilder
from app.tutor.session_state import TutorSessionState


class TutorChatService:

    @staticmethod
    def _response(
        *,
        session_id: str,
        student_message: str,
        intent: TutorIntent,
        decision,
        reply: str,
        provider: str,
        model: str,
        latency_ms: float = 0.0,
        math_validation=None,
        science_validation=None,
        english_validation=None,
        rag_context: RAGContext | None = None,
    ) -> TutorMessageResponse:

        return TutorMessageResponse(
            session_id=session_id,
            student_message=student_message,
            detected_intent=intent,
            decision=decision,
            math_validation=math_validation,
            science_validation=science_validation,
            english_validation=english_validation,
            rag_used=bool(
                rag_context and rag_context.has_context
            ),
            rag_sources=(
                rag_context.public_sources()
                if rag_context is not None
                else []
            ),
            reply=reply,
            provider=provider,
            model=model,
            latency_ms=latency_ms,
        )

    # =========================================
    # MAIN TUTOR WORKFLOW
    # =========================================

    @classmethod
    def process_message(
        cls,
        db: Session,
        session_id: str,
        student_message: str,
    ) -> TutorMessageResponse:

        learning_session = (
            LearningSessionRepository.get_by_id(
                db=db,
                session_id=session_id,
            )
        )

        if learning_session is None:
            raise ValueError(
                "Learning session not found."
            )

        student = StudentRepository.get_by_id(
            db=db,
            student_id=learning_session.student_id,
        )

        if student is None:
            raise ValueError(
                "Student not found."
            )

        subject = Subject(learning_session.subject)
        mode = LearningMode(learning_session.mode)

        intent = IntentRouter.classify(
            student_message
        )

        # =====================================
        # AI-04: INTERMEDIATE MATH REASONING
        # =====================================

        math_step_feedback = None

        if (
            subject == Subject.MATH
            and mode in {
                LearningMode.HOMEWORK_HELP,
                LearningMode.LEARN,
                LearningMode.PRACTICE,
            }
            and learning_session.current_problem
            and intent in {
                TutorIntent.LEARN_CONCEPT,
                TutorIntent.STUDENT_ATTEMPT,
            }
        ):

            recent = ChatHistoryService.get_recent_messages(
                db=db,
                session_id=session_id,
                limit=4,
            )

            previous_tutor_reply = next(
                (
                    item.content
                    for item in reversed(recent)
                    if item.role == "assistant"
                ),
                "",
            )

            math_step_feedback = cls._guided_math_step(
                problem=learning_session.current_problem,
                learner_message=student_message,
                previous_tutor_reply=previous_tutor_reply,
            )

            if (
                math_step_feedback is None
                and intent == TutorIntent.LEARN_CONCEPT
            ):
                math_step_feedback = cls._generic_math_reasoning(
                    student_message
                )

            if math_step_feedback is not None:
                intent = TutorIntent.STUDENT_ATTEMPT

        # =====================================
        # FRESH PRACTICE REQUEST
        # =====================================

        if intent == TutorIntent.PRACTICE_REQUEST:

            if (
                subject == Subject.MATH
                and mode in {
                    LearningMode.PRACTICE,
                    LearningMode.LEARN,
                }
            ):
                learning_session = cls._assign_next_math_problem(
                    db=db,
                    learning_session=learning_session,
                )

            elif subject == Subject.SCIENCE:
                learning_session = cls._assign_next_science_question(
                    db=db,
                    learning_session=learning_session,
                )

            elif subject == Subject.ENGLISH:
                learning_session = cls._assign_next_english_question(
                    db=db,
                    learning_session=learning_session,
                )

        # =====================================
        # SCIENCE / ENGLISH NATURAL ATTEMPTS
        # =====================================

        if (
            subject == Subject.SCIENCE
            and learning_session.current_problem
            and intent == TutorIntent.LEARN_CONCEPT
            and ScienceUnderstandingEvaluator.looks_like_answer(
                student_message
            )
        ):
            intent = TutorIntent.STUDENT_ATTEMPT

        if (
            subject == Subject.ENGLISH
            and learning_session.current_problem
            and intent == TutorIntent.LEARN_CONCEPT
            and EnglishEvaluator.looks_like_answer(
                student_message
            )
        ):
            intent = TutorIntent.STUDENT_ATTEMPT

        # =====================================
        # VALIDATE STUDENT ATTEMPTS
        # =====================================

        math_validation: MathValidationResult | None = None
        science_validation: ScienceValidationResult | None = None
        english_validation: EnglishValidationResult | None = None

        attempt_status: AttemptStatus | None = None

        hint_level_before = (
            learning_session.current_hint_level
        )

        if intent == TutorIntent.STUDENT_ATTEMPT:

            if math_step_feedback is not None:
                attempt_status = math_step_feedback[0]

            elif (
                subject == Subject.MATH
                and learning_session.current_problem
            ):
                # Normalize Unicode operators and "= ?".
                math_validation = MathAttemptService.analyze(
                    problem=cls._normalize_math_problem(
                        learning_session.current_problem
                    ),
                    student_message=student_message,
                )
                attempt_status = math_validation.status

            elif (
                subject == Subject.SCIENCE
                and learning_session.current_problem
                and learning_session.concept_code
            ):
                science_validation = ScienceAttemptService.analyze(
                    concept_code=learning_session.concept_code,
                    question_prompt=learning_session.current_problem,
                    student_message=student_message,
                )
                attempt_status = science_validation.status

            elif (
                subject == Subject.ENGLISH
                and learning_session.current_problem
                and learning_session.concept_code
            ):
                english_validation = EnglishAttemptService.analyze(
                    concept_code=learning_session.concept_code,
                    question_prompt=learning_session.current_problem,
                    student_message=student_message,
                )
                attempt_status = english_validation.status

            else:
                attempt_status = AttemptStatus.UNCLEAR

        # =====================================
        # TUTOR POLICY DECISION
        # =====================================

        gateway = LLMGateway()

        decision = TutorService.make_decision(
            db=db,
            session_id=session_id,
            decision_input=TutorDecisionInput(
                intent=intent,
                attempt_status=attempt_status,
            ),
            model_used=gateway.model_name,
        )

        refreshed_session = (
            LearningSessionRepository.get_by_id(
                db=db,
                session_id=session_id,
            )
        )

        if refreshed_session is None:
            raise ValueError(
                "Learning session could not be reloaded."
            )

        if math_step_feedback is not None:
            # TutorService increments the count for a
            # STUDENT_ATTEMPT. An intermediate step isn't
            # a scored final Math answer.
            refreshed_session.attempt_count = max(
                0,
                refreshed_session.attempt_count - 1,
            )

            refreshed_session = LearningSessionRepository.save(
                db=db,
                learning_session=refreshed_session,
            )

        # =====================================
        # RECORD LEARNING EVIDENCE
        # =====================================

        if math_validation is not None:
            MathAttemptService.record(
                db=db,
                learning_session=refreshed_session,
                student_message=student_message,
                validation=math_validation,
                hint_level_before=hint_level_before,
            )

        if science_validation is not None:
            ScienceAttemptService.record(
                db=db,
                learning_session=refreshed_session,
                student_message=student_message,
                validation=science_validation,
                hint_level_before=hint_level_before,
            )

        if english_validation is not None:
            EnglishAttemptService.record(
                db=db,
                learning_session=refreshed_session,
                student_message=student_message,
                validation=english_validation,
                hint_level_before=hint_level_before,
            )

        refreshed_session = (
            LearningSessionRepository.get_by_id(
                db=db,
                session_id=session_id,
            )
        )

        if refreshed_session is None:
            raise ValueError(
                "Learning session could not be reloaded."
            )

        # =====================================
        # AUTOMATIC NEXT PROBLEMS
        # =====================================

        next_math_problem = None
        next_science_question = None
        next_english_question = None

        if (
            math_validation is not None
            and math_validation.status == AttemptStatus.CORRECT
            and LearningMode(refreshed_session.mode) in {
                LearningMode.PRACTICE,
                LearningMode.LEARN,
            }
        ):

            previous = refreshed_session.current_problem

            refreshed_session = cls._assign_next_math_problem(
                db=db,
                learning_session=refreshed_session,
            )

            if refreshed_session.current_problem != previous:
                next_math_problem = (
                    refreshed_session.current_problem
                )

        if (
            science_validation is not None
            and science_validation.status == AttemptStatus.CORRECT
        ):

            previous = refreshed_session.current_problem

            refreshed_session = cls._assign_next_science_question(
                db=db,
                learning_session=refreshed_session,
            )

            if refreshed_session.current_problem != previous:
                next_science_question = (
                    refreshed_session.current_problem
                )

        if (
            english_validation is not None
            and english_validation.status == AttemptStatus.CORRECT
        ):

            previous = refreshed_session.current_problem

            refreshed_session = cls._assign_next_english_question(
                db=db,
                learning_session=refreshed_session,
            )

            if refreshed_session.current_problem != previous:
                next_english_question = (
                    refreshed_session.current_problem
                )

        # =====================================
        # SESSION STATE
        # =====================================

        state = TutorSessionState(
            session_id=refreshed_session.id,
            student_id=refreshed_session.student_id,
            age_group=AgeGroup(student.age_group),
            mode=LearningMode(refreshed_session.mode),
            subject=Subject(refreshed_session.subject),
            topic=refreshed_session.topic,
            concept_code=refreshed_session.concept_code,
            current_problem=refreshed_session.current_problem,
            attempt_count=refreshed_session.attempt_count,
            hint_level=refreshed_session.current_hint_level,
            direct_answer_requests=refreshed_session.direct_answer_requests,
            current_misconception=refreshed_session.current_misconception,
            mastery_state=MasteryState(
                refreshed_session.mastery_state
            ),
            adaptive_difficulty=decision.adaptive_difficulty,
            adaptive_support=decision.adaptive_support,
            explanation_depth=decision.explanation_depth,
        )

        public_math = (
            create_public_validation(math_validation)
            if math_validation is not None
            else None
        )

        public_science = (
            create_public_science_validation(science_validation)
            if science_validation is not None
            else None
        )

        public_english = (
            create_public_english_validation(english_validation)
            if english_validation is not None
            else None
        )

        response_args = dict(
            session_id=session_id,
            student_message=student_message,
            intent=intent,
            decision=decision,
            math_validation=public_math,
            science_validation=public_science,
            english_validation=public_english,
        )

        # =====================================
        # NEXT ADAPTIVE QUESTIONS
        # =====================================

        if next_math_problem is not None:
            return cls._response(
                **response_args,
                reply=(
                    "Correct. Now try this next problem: "
                    f"{next_math_problem}"
                ),
                provider="system",
                model="adaptive-practice",
            )

        if (
            next_science_question is not None
            and science_validation is not None
        ):
            recognized = ", ".join(
                science_validation.matched_ideas[:3]
            )

            reply = (
                f"Your explanation included the important ideas about {recognized}. "
                if recognized
                else "Your explanation shows the main idea. "
            )

            return cls._response(
                **response_args,
                reply=(
                    reply
                    + "Now try this next question: "
                    + next_science_question
                ),
                provider="system",
                model="science-rubric",
            )

        if (
            next_english_question is not None
            and english_validation is not None
        ):
            recognized = ", ".join(
                english_validation.matched_ideas[:2]
            )

            reply = (
                f"Good. Your response included {recognized}. "
                if recognized
                else "That response is correct. "
            )

            return cls._response(
                **response_args,
                reply=(
                    reply
                    + "Now try this next English question: "
                    + next_english_question
                ),
                provider="system",
                model="english-rubric",
            )
        
        # =====================================
        # AI-06: VERIFIED CORRECT MATH ANSWER
        # =====================================
        #
        # Only the deterministic validator
        # can establish correctness.
        #
        # Do not rely on the LLM to decide
        # whether a supported Math answer
        # is correct.
        #
        # In Learn/Practice mode, the
        # automatic next-problem branch
        # above takes precedence.
        # =====================================

        if (
            state.subject == Subject.MATH
            and state.mode == LearningMode.HOMEWORK_HELP
            and math_validation is not None
            and math_validation.supported
            and math_validation.status == AttemptStatus.CORRECT
        ):
            return cls._response(
                **response_args,
                reply=(
                    "Correct! Your answer matches the "
                    "Math problem. You worked it out "
                    "successfully. "
                    "Can you explain the main step "
                    "you used to reach your answer? "
                    "This will help me check "
                    "your understanding."
                ),
                provider="system",
                model="math-verified-answer",
            )

        # =====================================
        # AI-04: INTERMEDIATE MATH GUIDANCE
        # =====================================

        if math_step_feedback is not None:
            return cls._response(
                **response_args,
                reply=math_step_feedback[1],
                provider="system",
                model="guided-math-step",
            )

        # =====================================
        # AI-05: INCORRECT MATH FEEDBACK GUARD
        # =====================================

        if (
            state.subject == Subject.MATH
            and math_validation is not None
            and math_validation.supported
            and math_validation.status == AttemptStatus.INCORRECT
            and not decision.allow_final_answer
        ):
            reply = cls._math_retry_feedback(
                problem=state.current_problem or "",
                validation=math_validation,
                hint_level=decision.hint_level,
                db=db,
                session_id=session_id,
            )

            return cls._response(
                **response_args,
                reply=reply,
                provider="system",
                model="math-feedback-guard",
            )

        # =====================================
        # AI-02: ATTEMPT-FIRST PROTECTION
        # =====================================

        if (
            not decision.allow_final_answer
            and decision.next_action == TutorAction.ASK_ATTEMPT
        ):

            if state.subject == Subject.MATH:
                deterministic_reply = (
                    "I can help you work through the problem. "
                    "Which operation or rule would you apply first? "
                    "Tell me what you think, even if you're unsure."
                )

            elif state.subject == Subject.SCIENCE:
                deterministic_reply = (
                    "Let's explore this together. "
                    "What do you already know about the question? "
                    "Try one idea in your own words."
                )

            elif state.subject == Subject.ENGLISH:
                deterministic_reply = (
                    "Let's work on this together. "
                    "Try your own answer first, "
                    "even if you're not completely sure."
                )

            else:
                deterministic_reply = (
                    "Let's start with your attempt. "
                    "What have you tried so far?"
                )

        elif (
            intent == TutorIntent.DIRECT_ANSWER_REQUEST
            and not decision.allow_final_answer
        ):
            deterministic_reply = (
                "I can give you guidance, "
                "but I'd like you to do the reasoning. "
                "Which part of the problem are you unsure about?"
            )

        else:
            deterministic_reply = cls._deterministic_response(
                action=decision.next_action,
                state=state,
            )

        if deterministic_reply is not None:
            return cls._response(
                **response_args,
                reply=deterministic_reply,
                provider="system",
                model="deterministic",
            )

        # =====================================
        # CURRICULUM RAG
        # =====================================

        rag_context: RAGContext | None = None

        if decision.requires_rag:

            rag_query = RAGQueryBuilder.build(
                student_message=student_message,
                subject=state.subject,
                topic=state.topic,
                concept_code=state.concept_code,
                current_problem=state.current_problem,
            )

            rag_context = RAGService().retrieve(
                query=rag_query,
                subject=state.subject.value,
                concept_code=state.concept_code,
            )

            if not rag_context.has_context:
                return cls._response(
                    **response_args,
                    reply=(
                        "I don't have enough verified curriculum "
                        "material for this question yet."
                    ),
                    provider="system",
                    model="rag-grounding-guard",
                )

        # =====================================
        # LLM TUTOR
        # =====================================

        request = TutorPromptBuilder.build(
            student_message=student_message,
            state=state,
            decision=decision,
            math_validation=math_validation,
            science_validation=science_validation,
            english_validation=english_validation,
            rag_context=rag_context,
        )

        result = gateway.generate(request)

        reply = result.content
        provider = result.provider
        model = result.model

        # =====================================
        # AI-05: LLM OUTPUT VALIDATION
        # =====================================

        if (
            state.subject == Subject.MATH
            and not decision.allow_final_answer
            and state.current_problem
            and cls._leaks_math_answer(
                reply=reply,
                problem=state.current_problem,
                validation=math_validation,
            )
        ):
            reply = cls._safe_math_fallback(
                problem=state.current_problem,
                action=decision.next_action,
            )

            provider = "system"
            model = "math-output-guard"

        return cls._response(
            **response_args,
            reply=reply,
            provider=provider,
            model=model,
            latency_ms=result.latency_ms,
            rag_context=rag_context,
        )

    # =========================================
    # NORMALIZE MATH EXPRESSION
    # =========================================

    @staticmethod
    def _normalize_math_problem(
        problem: str,
    ) -> str:

        text = (
            problem.strip()
            .replace("×", "*")
            .replace("÷", "/")
            .replace("−", "-")
            .replace("–", "-")
            .replace("⁄", "/")
            .replace("＝", "=")
        )

        # Strip placeholder = ? but preserve
        # actual equations such as 3x + 5 = 20.
        text = re.sub(
            r"\s*=\s*\?\s*$",
            "",
            text,
        )

        return text.strip()

    # =========================================
    # COMPUTE REMAINING ARITHMETIC EXPRESSION
    # =========================================

    @staticmethod
    def _mixed_arithmetic_remainder(
        problem: str,
    ) -> str | None:

        expression = TutorChatService._normalize_math_problem(
            problem
        )

        # Support simple unparenthesized mixed
        # arithmetic; don't guess for algebra.
        if not re.fullmatch(
            r"-?\d+(?:\.\d+)?(?:\s*[+*/-]\s*-?\d+(?:\.\d+)?)+",
            expression,
        ):
            return None

        if not re.search(r"[*/]", expression):
            return None

        if not re.search(
            r"\d\s*[+-]\s*-?\d",
            expression,
        ):
            return None

        match = re.search(
            r"(?<![\d.])(-?\d+(?:\.\d+)?)\s*([*/])\s*"
            r"(-?\d+(?:\.\d+)?)(?![\d.])",
            expression,
        )

        if match is None:
            return None

        left, operator, right = match.groups()

        try:
            a = Decimal(left)
            b = Decimal(right)

            if operator == "/" and b == 0:
                return None

            value = (
                a * b
                if operator == "*"
                else a / b
            )

            value_text = format(
                value.normalize(),
                "f",
            )

        except (InvalidOperation, ZeroDivisionError):
            return None

        remaining = (
            expression[:match.start()]
            + value_text
            + expression[match.end():]
        )

        return (
            remaining
            .replace("*", "×")
            .replace("/", "÷")
        )

    # =========================================
    # SAFE INCORRECT-ANSWER FEEDBACK
    # =========================================

    @classmethod
    def _math_retry_feedback(
        cls,
        *,
        problem: str,
        validation: MathValidationResult,
        hint_level: int,
        db: Session,
        session_id: str,
    ) -> str:

        remainder = cls._mixed_arithmetic_remainder(
            problem
        )

        if remainder is not None:

            history = (
                ChatHistoryService.get_recent_messages(
                    db=db,
                    session_id=session_id,
                    limit=8,
                )
            )

            has_done_first_step = any(
                item.role == "assistant"
                and "expression becomes" in item.content.lower()
                for item in history
            )

            if has_done_first_step:

                if hint_level >= 5:
                    return (
                        "You've done the multiplication or division step. "
                        f"Check {remainder}. Try counting carefully "
                        "from the first number, one step at a time. "
                        "What sum do you get?"
                    )

                return (
                    "Good work on the earlier step. "
                    "Your final calculation needs another look: "
                    f"{remainder}. "
                    "Please try that calculation again."
                )

            return (
                "That answer doesn't match the expression. "
                "Check which operation comes first, calculate "
                "that part, then try the remaining arithmetic. "
                "What would your first calculation be?"
            )

        # Algebra misconception feedback

        if (
            validation.misconception_code
            == "MATH_DIVIDE_COEFFICIENT"
        ):
            return (
                "You have part of the equation right. "
                "What operation undoes multiplying by "
                "the coefficient of the variable? "
                "Try that next."
            )

        if (
            validation.misconception_code
            == "MATH_INVERSE_OPERATION"
        ):
            return (
                "Check the inverse operation you used. "
                "What should you do to both sides to "
                "keep the equation balanced?"
            )

        if validation.first_error_step:
            return (
                "Some of your work is on track. "
                "Please recheck this step: "
                f"{validation.first_error_step}. "
                "What operation should you apply there?"
            )

        return (
            "Not quite. Check the last operation carefully "
            "and try once more. Which step do you want to review?"
        )

    # =========================================
    # VERIFIED EXPECTED MATH ANSWER
    # =========================================

    @staticmethod
    def _expected_math_answer(
        problem: str,
        validation: MathValidationResult | None,
    ) -> str | None:

        if (
            validation is not None
            and validation.supported
            and validation.expected_answer is not None
        ):
            return str(
                validation.expected_answer
            )

        try:
            probe = MathAttemptService.analyze(
                problem=TutorChatService._normalize_math_problem(
                    problem
                ),
                student_message="",
            )

            if (
                probe.supported
                and probe.expected_answer is not None
            ):
                return str(
                    probe.expected_answer
                )

        except (ValueError, TypeError, ArithmeticError):
            pass

        return None

    # =========================================
    # MATH OUTPUT LEAK DETECTION
    # =========================================

    @classmethod
    def _leaks_math_answer(
        cls,
        *,
        reply: str,
        problem: str,
        validation: MathValidationResult | None,
    ) -> bool:

        expected = cls._expected_math_answer(
            problem,
            validation,
        )

        if not expected:

            return bool(
                re.search(
                    r"\b(?:final answer|correct answer|solution|answer is)\b"
                    r"\s*(?:is|equals|=|:)?\s*[-+]?\d",
                    reply,
                    flags=re.IGNORECASE,
                )
            )

        source = cls._normalize_math_problem(
            problem
        )

        escaped = re.escape(expected)

        # Accept sentence-ending punctuation after
        # a number; avoid matching 14 inside 140.
        token_re = (
            rf"(?<![\w.]){escaped}(?![\w]|\.\d)"
        )

        in_problem = bool(
            re.search(token_re, source)
        )

        in_reply = bool(
            re.search(token_re, reply)
        )

        if in_reply and not in_problem:
            return True

        if re.search(
            r"\b(?:final answer|correct answer|answer is|"
            r"solution is|result is|equals)\b"
            r".{0,24}"
            + token_re,
            reply,
            flags=re.IGNORECASE | re.DOTALL,
        ):
            return True

        number_words = (
            "zero one two three four five six seven eight nine ten "
            "eleven twelve thirteen fourteen fifteen sixteen seventeen "
            "eighteen nineteen twenty"
        ).split()

        try:
            numeric = int(expected)

            if (
                str(numeric) == expected
                and 0 <= numeric <= 20
            ):
                word = number_words[numeric]

                if re.search(
                    rf"\b{word}\b",
                    reply,
                    re.IGNORECASE,
                ):

                    if not re.search(
                        rf"\b{word}\b",
                        source,
                        re.IGNORECASE,
                    ):
                        return True

        except (ValueError, OverflowError):
            pass

        return False

    # =========================================
    # FALLBACK FOR UNSAFE LLM OUTPUT
    # =========================================

    @classmethod
    def _safe_math_fallback(
        cls,
        *,
        problem: str,
        action: TutorAction,
    ) -> str:

        remainder = cls._mixed_arithmetic_remainder(
            problem
        )

        if remainder is not None:
            return (
                "Let's focus on the next calculation, "
                "not the final answer. "
                f"Check {remainder} carefully "
                "and tell me the result."
            )

        if action == TutorAction.GIVE_HINT:
            return (
                "Here's a small hint: look for the "
                "operation or rule you need next. "
                "What would you try first?"
            )

        return (
            "I want you to work through the next step yourself. "
            "Show me one operation or line of working, "
            "and I'll help you check it."
        )

    # =========================================
    # GUIDED MATH STEPS — AI-04
    # =========================================

    @staticmethod
    def _guided_math_step(
        problem: str,
        learner_message: str,
        previous_tutor_reply: str = "",
    ) -> tuple[AttemptStatus, str] | None:

        expression = (
            problem
            .replace("×", "*")
            .replace("÷", "/")
            .replace("−", "-")
            .strip()
        )

        expression = re.sub(
            r"\s*=\s*\?\s*$",
            "",
            expression,
        ).strip()

        if (
            not re.fullmatch(
                r"-?\d+(?:\.\d+)?(?:\s*[+*/-]\s*-?\d+(?:\.\d+)?)+",
                expression,
            )
            or not re.search(r"[*/]", expression)
        ):
            return None

        if not re.search(
            r"\d\s*[+]\s*-?\d|\d\s*[-]\s*\d",
            expression,
        ):
            return None

        match = re.search(
            r"(?<![\d.])(-?\d+(?:\.\d+)?)\s*([*/])\s*"
            r"(-?\d+(?:\.\d+)?)(?![\d.])",
            expression,
        )

        if not match:
            return None

        left, operator, right = match.groups()

        try:
            a = Decimal(left)
            b = Decimal(right)

            if operator == "/" and b == 0:
                return None

            intermediate = (
                a * b
                if operator == "*"
                else a / b
            )

        except (InvalidOperation, ZeroDivisionError):
            return None

        display_operator = (
            "×" if operator == "*" else "÷"
        )

        term = (
            f"{left} {display_operator} {right}"
        )

        expected_text = format(
            intermediate.normalize(),
            "f",
        )

        simplified = (
            expression[:match.start()]
            + expected_text
            + expression[match.end():]
        )

        simplified = (
            simplified
            .replace("*", "×")
            .replace("/", "÷")
        )

        correct_word = (
            "multiplication"
            if operator == "*"
            else "division"
        )

        text = " ".join(
            learner_message.lower().split()
        )

        text = (
            text
            .replace("×", "*")
            .replace("÷", "/")
        )

        prev = (
            previous_tutor_reply
            .lower()
            .replace("×", "*")
            .replace("÷", "/")
        )

        operand_pair = (
            f"{left} {operator} {right}".lower()
        )

        waiting_for_number = (
            operand_pair in prev
            and (
                "what is " in prev
                or "calculate " in prev
                or "what value" in prev
                or "work out " in prev
            )
        )

        intermediate_text = None

        if waiting_for_number:

            bare = re.fullmatch(
                r"\s*(-?\d+(?:\.\d+)?)\s*[.!]?\s*",
                text,
            )

            if bare:
                intermediate_text = bare.group(1)

            else:
                step_equation = re.fullmatch(
                    (
                        r"\s*"
                        + re.escape(operand_pair).replace(
                            r"\ ",
                            r"\s*",
                        )
                        + r"\s*=\s*(-?\d+(?:\.\d+)?)\s*"
                    ),
                    text,
                )

                if step_equation:
                    intermediate_text = (
                        step_equation.group(1)
                    )

        if intermediate_text is not None:

            try:
                student_value = Decimal(
                    intermediate_text
                )

            except InvalidOperation:
                return None

            if student_value == intermediate:

                return (
                    AttemptStatus.PARTIALLY_CORRECT,
                    (
                        f"Yes, {term} = {expected_text}. "
                        f"Now the expression becomes {simplified}. "
                        "Can you finish the remaining calculation?"
                    ),
                )

            # A learner might submit the entire
            # correct result at this point.
            try:
                final_value = evaluate_arithmetic(
                    expression
                )

                if (
                    abs(
                        float(student_value)
                        - float(final_value)
                    ) < 1e-10
                ):
                    return None

            except (
                ValueError,
                TypeError,
                OverflowError,
                ZeroDivisionError,
            ):
                pass

            return (
                AttemptStatus.INCORRECT,
                (
                    f"Not quite. Let's calculate {term} "
                    "on its own first. Try that multiplication "
                    "or division again before combining it "
                    "with the rest of the expression."
                ),
            )

        if re.match(
            r"^(why|how|what|can|could|please)\b",
            text,
        ):
            return None

        operation_words = {
            "multiplication": (
                r"\b(?:multiplication|multiply|multiplying|product)\b"
            ),
            "division": (
                r"\b(?:division|divide|dividing|quotient)\b"
            ),
            "addition": (
                r"\b(?:addition|add|adding|sum)\b"
            ),
            "subtraction": (
                r"\b(?:subtraction|subtract|subtracting)\b"
            ),
        }

        choices = [
            (op, m.start())
            for op, pattern in operation_words.items()
            if (
                m := re.search(pattern, text)
            )
        ]

        if not choices:
            return None

        if not (
            re.search(
                (
                    r"\b(?:think|first|start|begin|apply|"
                    r"would|should|do|choose|use|"
                    r"comes|before|next)\b"
                ),
                text,
            )
            or text in operation_words
        ):
            return None

        chosen_operation = min(
            choices,
            key=lambda item: item[1],
        )[0]

        if chosen_operation != correct_word:
            return (
                AttemptStatus.INCORRECT,
                (
                    "That's a useful idea to test. "
                    "In mixed arithmetic, multiplication "
                    "and division take priority over "
                    "addition and subtraction. "
                    "Look again: which operation "
                    "should you perform first?"
                ),
            )

        if waiting_for_number:
            return (
                AttemptStatus.PARTIALLY_CORRECT,
                (
                    f"You've identified {correct_word} correctly. "
                    "Let's move to the calculation itself: "
                    f"what is {term}?"
                ),
            )

        return (
            AttemptStatus.PARTIALLY_CORRECT,
            (
                f"Correct—{correct_word} is the first "
                f"operation here. Now calculate {term}. "
                "What value do you get?"
            ),
        )

    # =========================================
    # GENERIC MATH REASONING
    # =========================================

    @staticmethod
    def _generic_math_reasoning(
        learner_message: str,
    ) -> tuple[AttemptStatus, str] | None:

        text = " ".join(
            learner_message.lower().split()
        )

        if re.match(
            r"^(why|how|what|can|could|please)\b",
            text,
        ):
            return None

        if not re.search(
            (
                r"\b(?:i think|i would|we should|first|"
                r"start|begin|apply|will apply|"
                r"would apply|i will|i should|let's)\b"
            ),
            text,
        ):
            return None

        if not re.search(
            (
                r"\b(?:multiply|multiplication|divide|"
                r"division|add|addition|subtract|"
                r"subtraction|simplify|factor|expand|"
                r"isolate|substitute|combine|cancel)\b"
            ),
            text,
        ):
            return None

        return (
            AttemptStatus.UNCLEAR,
            (
                "Thanks for showing your thinking. "
                "Please write the next line after applying "
                "that operation. I'll help check whether "
                "the step is correct, without jumping "
                "to the answer."
            ),
        )

    # =========================================
    # NEXT MATH PROBLEM
    # =========================================

    @classmethod
    def _assign_next_math_problem(
        cls,
        db: Session,
        learning_session,
    ):

        concept_code = learning_session.concept_code

        if concept_code is None:
            return learning_session

        difficulty = DifficultyLevel.EASY

        try:
            plan = AdaptiveLearningService.get_plan(
                db=db,
                student_id=learning_session.student_id,
                concept_code=concept_code,
            )

            difficulty = plan.difficulty

        except (LookupError, ValueError):
            pass

        attempts = [
            attempt
            for attempt in StudentAttemptRepository.list_by_student(
                db=db,
                student_id=learning_session.student_id,
            )
            if attempt.problem_ref == concept_code
        ]

        offset = len(attempts)

        problem = get_adaptive_problem(
            concept_code=concept_code,
            difficulty=difficulty,
            offset=offset,
        )

        if (
            problem is not None
            and problem.prompt == learning_session.current_problem
        ):
            problem = get_adaptive_problem(
                concept_code=concept_code,
                difficulty=difficulty,
                offset=offset + 1,
            )

        if problem is None:
            return learning_session

        learning_session.current_problem = problem.prompt
        learning_session.current_hint_level = 0
        learning_session.attempt_count = 0
        learning_session.current_misconception = None

        return LearningSessionRepository.save(
            db=db,
            learning_session=learning_session,
        )

