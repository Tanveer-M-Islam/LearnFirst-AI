    # =========================================
    # EXISTING DETERMINISTIC RESPONSES
    # =========================================

    @staticmethod
    def _deterministic_response(
        action: TutorAction,
        state: TutorSessionState,
    ) -> str | None:

        if (
            action == TutorAction.GENERATE_PRACTICE_QUESTION
            and state.current_problem
        ):

            if state.subject == Subject.SCIENCE:
                return (
                    "Here is your Science question: "
                    f"{state.current_problem} "
                    "Explain the idea in your own words."
                )

            if state.subject == Subject.ENGLISH:
                return (
                    "Here is your English question: "
                    f"{state.current_problem} "
                    "Try it independently first."
                )

            return (
                "Here is your practice problem: "
                f"{state.current_problem}. "
                "Try it first and show me "
                "your answer or next step."
            )

        if action == TutorAction.REFUSE_POLICY_BYPASS:
            return (
                "I can help you work through the task, "
                "but I won't skip the learning steps "
                "just to reveal the answer."
            )

        if action == TutorAction.CLARIFY_TEST_INSTRUCTION:
            return (
                "This is Mock Test Mode, "
                "so I can't give hints or solutions "
                "during the test."
            )

        if action == TutorAction.ESCALATE_SAFETY:
            return (
                "I can't handle this as a normal learning question. "
                "Please involve a trusted adult who can help."
            )

        return None
