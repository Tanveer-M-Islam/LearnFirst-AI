APP_NAME=LearnFirst AI
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./learnfirst.db


# ---------------------------------------
# LLM
# ---------------------------------------

LLM_PROVIDER=mock

OLLAMA_BASE_URL=http://localhost:11434

OLLAMA_MODEL=llama3.2

OLLAMA_TIMEOUT_SECONDS=60

LLM_TEMPERATURE=0.2

LLM_MAX_TOKENS=300